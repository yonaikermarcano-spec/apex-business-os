# Apex Business OS — Variables de Entorno
# Copia este archivo como .env.local y rellena tus valores

# ─── GitHub como Base de Datos ──────────────────────────────────────
# Crea un Personal Access Token en: https://github.com/settings/tokens
# Permisos necesarios: repo (read + write contents)
VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Tu usuario de GitHub
VITE_GITHUB_OWNER=yonaikermarcano

# Nombre del repositorio donde se guardará data/business_data.json
VITE_GITHUB_REPO=apex-business-os

# Rama a usar (normalmente main)
VITE_GITHUB_BRANCH=main

# ─── IA SOFIA (Gemini) ──────────────────────────────────────────────
# Obtén tu API Key GRATIS en: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
